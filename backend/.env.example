# Single-network backend: one process = one Solana cluster.
# Frontends discover RPC/WS/program/mints via GET /v1/client-config.

APP_ENV=local
# Required when APP_ENV is not local:
# DEPLOYMENT_ID=devnet-eu-west-1-2026-07

SOLANA_RPC_URL=http://127.0.0.1:8901
SOLANA_NETWORK=localnet
PROGRAM_ID=BZQaR9BcpRBnGedU6BPAWwocHwvdCdjcJYD1doCVXhcS
VAULT_AUTHORITY=admwu2g9WV2kdwTzjasLXTy7tWq3W15BrP4PE7UZJ5x
DEFAULT_ASSET_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Browser-safe RPC/WS returned in /v1/client-config (may differ from SOLANA_RPC_URL).
PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8901
PUBLIC_SOLANA_WS_URL=ws://127.0.0.1:8900

# Optional server-side admin signer for /v1/admin/*
# ADMIN_KEYPAIR_PATH=.secrets/admwu2g9WV2kdwTzjasLXTy7tWq3W15BrP4PE7UZJ5x.json

# Optional public links (local defaults admin dashboard to http://localhost:3002)
# ADMIN_DASHBOARD_URL=http://localhost:3002
# PUBLIC_APP_URL=http://localhost:3001

BIND_HOST=0.0.0.0
BIND_PORT=8080

# Optional Jupiter API hosts (defaults: quote-api.jup.ag/v6)
# JUPITER_QUOTE_API_BASE=https://quote-api.jup.ag/v6
# JUPITER_SWAP_API_BASE=https://quote-api.jup.ag/v6

ANCHOR_WALLET_PATH=.secrets/admwu2g9WV2kdwTzjasLXTy7tWq3W15BrP4PE7UZJ5x.json

# solana-test-validator RPC port (default matches run_backend_smoke.sh).
RPC_PORT=8901


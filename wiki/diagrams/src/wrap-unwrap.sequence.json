  "cards": [
    {
      "dot": "cyan",
      "title": "Read vs Build Policy",
      "items": [
        "Quotes are public reads: a token_vault balance failure degrades to 0 with a warning",
        "Tx builds fail fast: RPC errors return 400 with the outer error context only",
        "Every built tx is decoded and checked to target the wrap-stablecoin program"
      ]
    },
    {
      "dot": "violet",
      "title": "Wallet Boundary",
      "items": [
        "The backend never signs; the user wallet is fee payer and sole signer",
        "The frontend simulates, signs locally, and broadcasts on its own RPC",
        "An expired blockhash triggers one rebuild and a second approval"
      ]
    },
    {
      "dot": "emerald",
      "title": "On-chain Guards",
      "items": [
        "Wrap: pause, mint authority, allowlist, mint_allowed, mint and exposure caps",
        "Unwrap: pause, allowlist, redeem_allowed, pool liability, token_vault liquidity",
        "Haircuts are applied by the program; quotes mirror the same conversion"
      ]
    }
  ]
